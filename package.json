{
  "name": "vue3-ts-cesium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host",
    "dev:city": "vite --host --mode city",
    "dev:decimal": "vite --host --mode advanced-decimal",
    "dev:standard:decimal": "vite --host --mode standard-decimal",
    "dev:city:decimal": "vite --host --mode city-decimal",
    "preview": "vite preview",
    "build:standard": "vite build --mode standard",
    "build:advanced": "vite build --mode advanced",
    "build:city": "vite build --mode city",
    "build:standard:decimal": "vite build --mode standard-decimal",
    "build:advanced:decimal": "vite build --mode advanced-decimal",
    "build:city:decimal": "vite build --mode city-decimal",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "element-plus": "^2.13.5",
    "three": "^0.184.0",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}